{
  "$schema": "https://opencode.ai/config.json",

  "providers": {
    "amazon-bedrock": {
      "settings": { "profile": "by-sales", "region": "us-east-1" },
    },
  },

  // Hidden title agent runs every session - route to Haiku.
  "agents": {
    "title": { "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0" },
  },

  "permissions": [
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
  ],

  // Hard denies - project config and "Allow always" cannot lift these.
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "amazon-bedrock", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env.example", "effect": "allow" },
  ],

  "websearch": { "provider": "tavily" },

  // Built-ins (ruff, shfmt, prettier, biome, ...) enabled by object form.
  "formatter": {
    "stylua": {
      "command": ["stylua", "--indent-type", "Spaces", "--indent-width", "2", "--column-width", "120", "$FILE"],
      "extensions": [".lua"],
    },
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".venv/**",
      ".idea/**",
      ".ruff_cache/**",
      ".pytest_cache/**",
      "__pycache__/**",
      "**/*.pyc",
      "**/*.egg-info/**",
      "coverage/**",
      "dist/**",
      "build/**",
      ".aws-sam/**",
    ],
  },

  // Auto-compaction ceiling = window - buffer. 1M models -> 200K. Not clamped: a 200K model would compact every turn.
  "compaction": { "keep": { "tokens": 30000 }, "buffer": 800000 },

  "update": "notify",
}
