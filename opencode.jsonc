{
  "$schema": "https://opencode.ai/config.json",

  "providers": {
    "amazon-bedrock": {
      "settings": {
        "region": "{file:.secrets/aws-region}",
        "profile": "{file:.secrets/aws-profile}",
      },
    },
    "anthropic": {
      "settings": {
        "baseURL": "{file:.secrets/anthropic-base-url}",
        "apiKey": "{file:.secrets/anthropic-api-key}",
      },
    },
  },

  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
  ],

  "websearch": { "provider": "tavily" },

  // Built-ins (ruff, shfmt, prettier, biome, ...) enabled by object form.
  "formatter": {
    "stylua": {
      "command": [
        "stylua",
        "--indent-type",
        "Spaces",
        "--indent-width",
        "2",
        "--column-width",
        "120",
        "$FILE",
      ],
      "extensions": [".lua"],
    },
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".venv/**",
      ".idea/**",
      ".ruff_cache/**",
      ".pytest_cache/**",
      "__pycache__/**",
      "**/*.pyc",
      "**/*.egg-info/**",
      "coverage/**",
      "dist/**",
      "build/**",
      ".aws-sam/**",
    ],
  },

  "update": "notify",

  "compaction": { "keep": { "tokens": 30000 } },

  "plugins": ["opencode-with-claude"],
}
