{
  "$schema": "https://opencode.ai/config.json",

  "providers": {
    "amazon-bedrock": {
      "settings": { "profile": "by-sales", "region": "us-east-1" },
    },
  },

  // Hidden title agent runs every session — route to Haiku.
  "agents": {
    "title": { "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0" },
  },

  "permissions": [{ "action": "shell", "resource": "git push *", "effect": "ask" }],

  // Hard denies — project config and "Allow always" cannot lift these.
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      { "action": "provider.use", "resource": "amazon-bedrock", "effect": "allow" },
      { "action": "permission", "resource": "read:*.env", "effect": "deny" },
      { "action": "permission", "resource": "read:*.env.*", "effect": "deny" },
      { "action": "permission", "resource": "read:*.env.example", "effect": "allow" },
      { "action": "permission", "resource": "edit:*.env", "effect": "deny" },
      { "action": "permission", "resource": "edit:*.env.*", "effect": "deny" },
    ],
  },

  "websearch": { "provider": "tavily" },

  // Built-ins (ruff, shfmt, prettier, biome, ...) enabled by object form.
  "formatter": {
    "stylua": {
      "command": ["stylua", "--indent-type", "Spaces", "--indent-width", "2", "--column-width", "120", "$FILE"],
      "extensions": [".lua"],
    },
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".venv/**",
      ".idea/**",
      ".ruff_cache/**",
      ".pytest_cache/**",
      "__pycache__/**",
      "**/*.pyc",
      "**/*.egg-info/**",
      "coverage/**",
      "dist/**",
      "build/**",
      ".aws-sam/**",
    ],
  },

  "compaction": { "keep": { "tokens": 30000 }, "buffer": 20000 },

  "update": "notify",

  "plugins": ["@tarquinen/opencode-dcp@3.2.0"],
}
